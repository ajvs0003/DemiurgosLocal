{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "disabled_providers": ["opencode"],
  "permission": {
    "bash": "ask",
  },
  "model": "github-copilot/gpt-4.1",
  "plugin": [
    "opencode-claude-auth",
    "@tarquinen/opencode-dcp@latest",
    "@mohak34/opencode-notifier@latest",
  ],
}
